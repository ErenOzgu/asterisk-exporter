        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "asterisk_pjsip_endpoint_active_channels{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "B",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "endpoint",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "job 1": true,
              "job 2": true,
              "instance 2": true
            },
            "renameByName": {
              "endpoint": "Endpoint",
              "instance 1": "Instance",
              "Value #A": "State",
              "Value #B": "Active channels"
            },
            "indexByName": {
              "endpoint": 0,
              "instance 1": 1,
              "Value #A": 2,
              "Value #B": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "State",
                "desc": false
              },
              {
                "field": "Endpoint",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "available",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "unavailable",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "available",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "unavailable",
                        "color": "red",
